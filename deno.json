{
  "nodeModulesDir": "auto",
  "lock": {
    "path": "./deno.lock"
  },
  "tasks": {
    "dev": "vite",
    "dev:service": "deno run --watch --allow-net --allow-env=OKF_HOST,OKF_PORT,OKF_DATA_DIR,OKF_STATIC_DIR,PRODUCTION,NODE_ENV --allow-read=.okf-data --allow-write=.okf-data server/main.ts",
    "build": "vite build",
    "start": "deno run --allow-net --allow-env=OKF_HOST,OKF_PORT,OKF_DATA_DIR,OKF_STATIC_DIR,PRODUCTION,NODE_ENV --allow-read=.okf-data,dist --allow-write=.okf-data server/main.ts",
    "stack": "deno run --allow-read=.okf-stack.env,backups --allow-write=.okf-stack.env,backups --allow-run=docker scripts/stack.ts up",
    "stack:down": "deno run --allow-read=.okf-stack.env --allow-write=.okf-stack.env --allow-run=docker scripts/stack.ts down",
    "stack:backup": "deno run --allow-read=.okf-stack.env,backups --allow-write=.okf-stack.env,backups --allow-run=docker scripts/stack.ts backup",
    "stack:restore": "deno run --allow-read=.okf-stack.env,backups --allow-write=.okf-stack.env,backups --allow-run=docker scripts/stack.ts restore",
    "typecheck": "tsc --noEmit",
    "lint": "deno lint src server scripts tests vite.config.ts",
    "test": "deno task typecheck && deno task build && deno task lint && deno test --allow-net --allow-env --allow-read --allow-write tests server"
  }
}
